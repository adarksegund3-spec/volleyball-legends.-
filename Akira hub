local U = {}
local remoteCache = {}

function U.getKnitRoot()
    local pkgs = ReplicatedStorage:FindFirstChild("Packages")
    if not pkgs then return nil end
    local idx = pkgs:FindFirstChild("_Index")
    if not idx then return nil end
    for _, f in ipairs(idx:GetChildren()) do
        if f.Name:find("sleitnick_knit") then return f end
    end
    return nil
end

function U.getRemote(serviceName, remoteType, remoteName)
    local key = serviceName .. "/" .. remoteType .. "/" .. remoteName
    local cached = remoteCache[key]
    if cached and cached.Parent then return cached end
    local root = U.getKnitRoot()
    if not root then return nil end
    local knit = root:FindFirstChild("knit")
    local svcs = knit and knit:FindFirstChild("Services")
    local svc = svcs and svcs:FindFirstChild(serviceName)
    if not svc then return nil end
    local cont = svc:FindFirstChild(remoteType)
    if not cont then return nil end
    local r = cont:FindFirstChild(remoteName)
    if r then remoteCache[key] = r end
    return r
end

function U.invoke(serviceName, remoteType, remoteName, ...)
    local r = U.getRemote(serviceName, remoteType, remoteName)
    if not r then return false, "Remote ausente" end
    local args = {...}
    local ok, res = pcall(function() return r:InvokeServer(table.unpack(args)) end)
    return ok, res
end

