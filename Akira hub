local menuTransparent = config.menuTransparent or false
local transpTargets = {}

local function registerTransp(el, normal, transparent)
    table.insert(transpTargets, {El = el, N = normal, T = transparent})
end

local function applyTransparency(on)
    for _, t in ipairs(transpTargets) do
        if t.El and t.El.Parent then
            t.El.BackgroundTransparency = on and t.T or t.N
        end
    end
    if BackgroundImg and BackgroundImg.Parent then
        BackgroundImg.ImageTransparency = on and 0.7 or 0
    end
end

registerTransp(MainFrame, 0, 0.5)

local uiVisible = true
local animating = false

local function toggleUI()
    if animating then return end
    animating = true
    uiVisible = not uiVisible
    local bgTarget = menuTransparent and 0.7 or 0
    if uiVisible then
        MainFrame.Visible = true
        MainFrame.Position = CLOSED_POS
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = OPEN_POS}):Play()
        TweenService:Create(BackgroundImg, TweenInfo.new(0.3), {ImageTransparency = bgTarget}):Play()
        TweenService:Create(MainStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
        task.wait(0.4)
    else
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = CLOSED_POS}):Play()
        TweenService:Create(BackgroundImg, TweenInfo.new(0.25), {ImageTransparency = 1}):Play()
        TweenService:Create(MainStroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
        task.wait(0.3)
        MainFrame.Visible = false
    end
    animating = false
end

