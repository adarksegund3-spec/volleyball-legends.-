-- ============ HITBOX ============
local Hitbox = createTab("Hitbox", "🎯")
addSection(Hitbox, "Hitbox da Bola")

local hitboxes = {}

local function removeHitbox(model)
    if hitboxes[model] and hitboxes[model].Parent then hitboxes[model]:Destroy() end
    hitboxes[model] = nil
end

local function createHitbox(model)
    if not config.hitboxEnabled or not model or not model.Parent then return end
    local part = model:FindFirstChild("Cube.001")
        or model:FindFirstChild("Sphere.001")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    removeHitbox(model)

    local hb = Instance.new("Part")
    hb.Name = "AkiraHitbox"
    hb.Shape = Enum.PartType.Ball
    hb.Size = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
    hb.CFrame = part.CFrame
    hb.Color = Color3.fromRGB(50, 255, 100)
    hb.Material = Enum.Material.ForceField
    hb.Transparency = 0.65
    hb.CanCollide = false
    hb.Massless = true
    hb.Parent = model

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = part
    weld.Part1 = hb
    weld.Parent = hb

    hitboxes[model] = hb
end

addToggle(Hitbox, "Hitbox Aumentada", config.hitboxEnabled, function(v)
    config.hitboxEnabled = v; saveConfig()
    if v then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if Ball.isBallModel(obj) then createHitbox(obj) end
        end
    else
        for m, _ in pairs(hitboxes) do removeHitbox(m) end
    end
end)

addSlider(Hitbox, "Tamanho da Hitbox", 6, 50, config.hitboxSize, function(v)
    config.hitboxSize = v; saveConfig()
    for _, hb in pairs(hitboxes) do
        if hb and hb.Parent then
            hb.Size = Vector3.new(v, v, v)
        end
    end
end)

CM.track(Workspace.ChildAdded:Connect(function(obj)
    if Ball.isBallModel(obj) and config.hitboxEnabled then createHitbox(obj) end
end))

