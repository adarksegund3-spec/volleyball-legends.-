local menuTransparencyEnabled = config.menuTransparent or false
local transparencyTargets = {}

local function registerTransparencyTarget(element, normalT, transparentT)
    table.insert(transparencyTargets, {Element = element, Normal = normalT, Transparent = transparentT})
end

local function applyMenuTransparency(enabled)
    for _, t in ipairs(transparencyTargets) do
        if t.Element and t.Element.Parent then
            t.Element.BackgroundTransparency = enabled and t.Transparent or t.Normal
        end
    end
    if BackgroundImg and BackgroundImg.Parent then
        BackgroundImg.ImageTransparency = enabled and 0.7 or 0
    end
end

