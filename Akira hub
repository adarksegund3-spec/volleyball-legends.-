        local root = char:FindFirstChild("HumanoidRootPart")
        
        if humanoid and root then
            local ballPart = getBall()
            if ballPart then
                humanoid:MoveTo(ballPart.Position)
                local distance = (ballPart.Position - root.Position).Magnitude
                if distance <= 15 then
                    if ballPart.Position.Y > root.Position.Y + 3 then
                        pressSpace()
                        pressClick()
                    end
                end
            end
        end
    end
end)

-- 3. HITBOX
local PageHitbox = createTab("Hitbox", "🎯")
addSection(PageHitbox, "Hitbox da Bola")

local HitboxEnabled = false
local HitboxSize = 15
local Hitboxes = {}

local function isBall(object)
    return object:IsA("Model") and string.find(object.Name, "CLIENT_BALL", 1, true) ~= nil
end

local function removeHitbox(ballModel)
    if Hitboxes[ballModel] and Hitboxes[ballModel].Parent then 
        Hitboxes[ballModel]:Destroy() 
    end
    Hitboxes[ballModel] = nil
end

local function createHitbox(ballModel)
    if not HitboxEnabled or not ballModel or not ballModel.Parent then return end
    local ballPart = ballModel.PrimaryPart or ballModel:FindFirstChild("Sphere.001") or ballModel:FindFirstChildWhichIsA("BasePart", true)
    if not ballPart then return end
    
    removeHitbox(ballModel)

    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxVisual"
    hitbox.Shape = Enum.PartType.Ball
    hitbox.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    hitbox.CFrame = ballPart.CFrame
    hitbox.Color = Color3.fromRGB(50, 255, 100)
    hitbox.Material = Enum.Material.ForceField
    hitbox.Transparency = 0.65
    hitbox.CanCollide = false
    hitbox.Massless = true
    hitbox.Parent = ballModel

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = ballPart
    weld.Part1 = hitbox
    weld.Parent = hitbox

    Hitboxes[ballModel] = hitbox
end

addToggle(PageHitbox, "Hitbox Aumentada", false, function(v)
    HitboxEnabled = v
    if v then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isBall(obj) then createHitbox(obj) end
        end
    else
        for ballModel, _ in pairs(Hitboxes) do removeHitbox(ballModel) end
    end
end)

addSlider(PageHitbox, "Tamanho da Hitbox", 6, 50, HitboxSize, function(v)
    HitboxSize = v
    for _, hitbox in pairs(Hitboxes) do
        if hitbox and hitbox.Parent then
            hitbox.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        end
    end
end)

Workspace.ChildAdded:Connect(function(obj)
    if isBall(obj) and HitboxEnabled then createHitbox(obj) end
end)

