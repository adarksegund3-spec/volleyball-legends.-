local Ball = {}

function Ball.find()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:find("CLIENT_BALL") then
            local part = obj:FindFirstChild("Cube.001")
                or obj:FindFirstChild("Sphere.001")
                or obj.PrimaryPart
                or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part, obj end
        end
    end
    return nil, nil
end

function Ball.isBallModel(obj)
    return obj:IsA("Model") and string.find(obj.Name, "CLIENT_BALL", 1, true) ~= nil
end

-- ============ PLAYER ============
local P = {}

function P.char() return LocalPlayer.Character end
function P.hum() local c = P.char(); return c and c:FindFirstChildOfClass("Humanoid") end
function P.root() local c = P.char(); return c and c:FindFirstChild("HumanoidRootPart") end
function P.alive() local h = P.hum(); return h and h.Health > 0 end
function P.team() return LocalPlayer.Team and LocalPlayer.Team.Name or "Nenhum" end
function P.tool() local c = P.char(); return c and c:FindFirstChildOfClass("Tool") end

function P.nearestPlayer(maxDist)
    local myRoot = P.root()
    if not myRoot then return nil, nil end
    local bestD, bestP = maxDist or math.huge, nil
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local r = pl.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < bestD then bestD, bestP = d, pl end
            end
        end
    end
    return bestP, bestD
end

function P.countAlive()
    local n = 0
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then
            local h = pl.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then n = n + 1 end
        end
    end
    return n
end

