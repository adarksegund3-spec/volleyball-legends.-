local CM = { connections = {}, loops = {} }

function CM.track(conn)
    table.insert(CM.connections, conn)
    return conn
end

function CM.startLoop(name, fn)
    CM.stopLoop(name)
    CM.loops[name] = task.spawn(fn)
end

function CM.stopLoop(name)
    if CM.loops[name] then
        pcall(function() task.cancel(CM.loops[name]) end)
        CM.loops[name] = nil
    end
end

