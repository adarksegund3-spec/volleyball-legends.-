-- SISTEMA DE ANIMAÇÃO PROFISSIONAL PARA ABRIR E FECHAR
local uiVisible = true
local isAnimating = false

local function toggleUI()
    if isAnimating then return end
    isAnimating = true
    uiVisible = not uiVisible

    local bgTarget = menuTransparencyEnabled and 0.7 or 0

    if uiVisible then
        MainFrame.Visible = true
        MainFrame.Position = CLOSED_POS
        
        local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = OPEN_POS})
        local tweenBg = TweenService:Create(BackgroundImg, TweenInfo.new(0.3), {ImageTransparency = bgTarget})
        local tweenStroke = TweenService:Create(MainStroke, TweenInfo.new(0.3), {Transparency = 0})

        tweenPos:Play()
        tweenBg:Play()
        tweenStroke:Play()
        
        tweenPos.Completed:Connect(function()
            isAnimating = false
        end)
    else
        local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = CLOSED_POS})
        local tweenBg = TweenService:Create(BackgroundImg, TweenInfo.new(0.25), {ImageTransparency = 1})
        local tweenStroke = TweenService:Create(MainStroke, TweenInfo.new(0.25), {Transparency = 1})

        tweenPos:Play()
        tweenBg:Play()
        tweenStroke:Play()

        tweenPos.Completed:Connect(function()
            MainFrame.Visible = false
            isAnimating = false
        end)
    end
end

